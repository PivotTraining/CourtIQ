# Copy to .env.local. Use the existing CourtIQ project, not another product's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only AFTER both Sept 30 ownership + recovery migrations and live QA.
NEXT_PUBLIC_TRACKER_RECOVERY_ENABLED=false
# Owner-managed roster games require the Oct 1 migration plus real authenticated QA.
NEXT_PUBLIC_COACH_GAMES_ENABLED=false
# Local sample-only dev route; ignored in production regardless of this value.
COURTIQ_LOCAL_PREVIEW=false
# Billing is test-only in this implementation. Use a separate verified Pivot sandbox.
# Do not put real secrets in this example or in any committed file.
NEXT_PUBLIC_COURTIQ_BILLING_ENABLED=false
# Free starter needs the Oct 1 starter/analytics migration AND reviewed grandfathering.
# Keep server, browser and database policy switches coordinated; no automatic activation.
NEXT_PUBLIC_COURTIQ_FREE_STARTER_ENABLED=false
COURTIQ_FREE_STARTER_ENABLED=false
NEXT_PUBLIC_COURTIQ_PREMIUM_ANALYTICS_ENABLED=false
COURTIQ_PREMIUM_ANALYTICS_ENABLED=false
COURTIQ_BILLING_ENABLED=false
COURTIQ_BILLING_MODE=test
COURTIQ_TRIAL_ENABLED=false
COURTIQ_BILLING_DELETION_GUARD_ENABLED=false
COURTIQ_APP_URL=
COURTIQ_BILLING_TERMS_VERSION=
STRIPE_SECRET_KEY=
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_PLAYER_MONTH_PRICE_ID=
STRIPE_PLAYER_YEAR_PRICE_ID=
STRIPE_COACH_MONTH_PRICE_ID=
STRIPE_COACH_YEAR_PRICE_ID=
STRIPE_COURTIQ_PORTAL_CONFIG_ID=
STRIPE_COURTIQ_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
