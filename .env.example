# Copy to .env.local. Use the existing CourtIQ project, not another product's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only AFTER both Sept 30 ownership + recovery migrations and live QA.
NEXT_PUBLIC_TRACKER_RECOVERY_ENABLED=false
# Owner-managed roster games require the Oct 1 migration plus real authenticated QA.
NEXT_PUBLIC_COACH_GAMES_ENABLED=false
# Local sample-only dev route; ignored in production regardless of this value.
COURTIQ_LOCAL_PREVIEW=false
